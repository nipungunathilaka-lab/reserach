APP_NAME=AI-Enhanced Secure File Transfer System
ENVIRONMENT=development
DATABASE_URL=sqlite:///./secure_file_transfer.db
SECRET_KEY=change-this-secret-key-before-real-use
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_UPLOAD_SIZE_MB=5000

# Authentication hardening
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# Local/prototype rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_REQUESTS=180
RATE_LIMIT_AUTH_REQUESTS=15
RATE_LIMIT_UPLOAD_REQUESTS=20

# MFA / OTP
MFA_OTP_EXPIRE_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_RESEND_COOLDOWN_SECONDS=60
MFA_MAX_RESENDS=3
DEV_SHOW_OTP=false

# AI model training. Default uses the lab dataset.
# After exporting real logs, use: AI_DATASET_PATH=real_transfer_dataset.csv
AI_DATASET_PATH=lab_secure_transfer_dataset.csv
AI_CONTAMINATION=0.15
AI_MIN_TRAINING_ROWS=50
AI_LARGE_FILE_MB=1024
AI_HIGH_RISK_FILE_EXTENSIONS=exe,bat,cmd,ps1,js,vbs,jar,msi,zip,rar,7z

SEED_DEMO_USERS=true
FRONTEND_ORIGIN=http://localhost:5173

# Optional SMTP email delivery for MFA OTP (via fastapi-mail)
MAIL_USERNAME=nipunmalshan350@gmail.com
MAIL_PASSWORD=rlbvietjtraezpih
MAIL_FROM=nipunmalshan350@gmail.com
MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=false
MAIL_SSL_TLS=true
USE_CREDENTIALS=true
VALIDATE_CERTS=true
